# Example VLM Provider Configuration
# Choose your provider and fill in your own API key:

# Option 1: NVIDIA NIM (Recommended / Preconfigured in UI)
VLM_PROVIDER=nvidia
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_API_KEY=your_nvidia_api_key_here
VLM_MODEL_NAME=nvidia/nemotron-3.5-super-vl-120b-a12b
# Alternative models:
# VLM_MODEL_NAME=stepfun-ai/step-5-preview
# VLM_MODEL_NAME=google/diffusiongemma-26b-a4b-it

# Option 2: HuggingFace Inference Endpoint
# VLM_PROVIDER=huggingface
# VLM_BASE_URL=http://your_endpoint.aws.endpoints.huggingface.cloud/v1
# VLM_API_KEY=hf_your_api_key_here
# VLM_MODEL_NAME=your_model_name
